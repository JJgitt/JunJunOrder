# Public address. Use https://order.example.com after DNS is ready.
SITE_ORIGIN=http://localhost
APP_DOMAIN=:80
# Match the host server's timezone; all UI dates and exports follow this value.
TZ=Asia/Shanghai

# PostgreSQL
POSTGRES_DB=junjun_order
POSTGRES_USER=junjun
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://junjun:replace-with-a-strong-database-password@localhost:5432/junjun_order
DATABASE_POOL_SIZE=10

# Authentication. Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
ADMIN_NAME=系统管理员
ADMIN_WECHAT_ID=junjun_admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Persistent uploads
UPLOAD_DIR=./data/uploads

# Optional legacy waybill OCR adapter (used only when VISION_* is not set)
OCR_ENDPOINT=
OCR_TOKEN=

# Optional vision model for order screenshots, waybill photos, and settlement screenshots
# Current provider: Zhipu GLM (OpenAI-compatible chat/completions). Keep the key out of Git.
VISION_API_BASE=https://open.bigmodel.cn/api/paas/v4
VISION_API_KEY=
VISION_MODEL=glm-5.3-flash
VISION_TIMEOUT_MS=75000

# Optional Dewu adapter
DEWU_SYNC_ENDPOINT=
DEWU_APP_KEY=
DEWU_APP_SECRET=
