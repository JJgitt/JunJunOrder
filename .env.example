# Public address. Use https://order.example.com after DNS is ready.
SITE_ORIGIN=http://localhost
APP_DOMAIN=:80

# PostgreSQL
POSTGRES_DB=junjun_order
POSTGRES_USER=junjun
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://junjun:replace-with-a-strong-database-password@localhost:5432/junjun_order
DATABASE_POOL_SIZE=10

# Authentication. Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
ADMIN_NAME=系统管理员
ADMIN_WECHAT_ID=junjun_admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Persistent uploads
UPLOAD_DIR=./data/uploads

# Optional legacy waybill OCR adapter (used only when VISION_* is not set)
OCR_ENDPOINT=
OCR_TOKEN=

# Optional vision model for order screenshots and waybill receipt photos (OpenAI-compatible chat/completions)
# e.g. Qwen: VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1  VISION_MODEL=qwen-vl-plus
VISION_API_BASE=
VISION_API_KEY=
VISION_MODEL=
VISION_TIMEOUT_MS=45000

# Optional Dewu adapter
DEWU_SYNC_ENDPOINT=
DEWU_APP_KEY=
DEWU_APP_SECRET=
